// =====================================================================
//  SIRDEPA - Sistema de Registro de Desembarque Pesquero Artesanal
//  Modelo relacional para dbdiagram.io (https://dbdiagram.io)
//  Generado desde sirdepa_schema.sql (capítulo 7 del informe); no editar a mano.
// =====================================================================

Project SIRDEPA {
  database_type: 'PostgreSQL'
  Note: 'ODS 14 - Registro de desembarque pesquero artesanal. Entidad central: desembarque.'
}

Enum categoria_embarcacion {
  ARTESANAL
  MENOR_ESCALA
}

Enum tipo_lugar {
  DPA
  CALETA
}

Enum tipo_comprador {
  COMERCIANTE
  PLANTA_PROCESADORA
  OTRO
}

Enum estado_aviso {
  PENDIENTE
  VINCULADO
  VENCIDO
}

Enum estado_validacion {
  CONFORME
  OBSERVADO
  NO_CONFORME
}

Enum estado_registro {
  VIGENTE
  ANULADO
}

Enum estado_constancia {
  VIGENTE
  ANULADA
}

Enum destino_saldo {
  CONSUMO_TRIPULACION
  MERMA
  ALMACENAMIENTO_DPA
}

Enum estado_lote {
  ASIGNADO
  RECIBIDO
  ANULADO
}

Enum tipo_notificacion {
  CODIGO_ACCESO
  CONSTANCIA
  LOTE
  PERMISO_POR_VENCER
  PERMISO_VENCIDO
}

Enum estado_envio {
  PENDIENTE
  ENVIADO
  FALLIDO
}

Enum tipo_alerta {
  NO_CONFORME
  OBSERVADO
}

Enum prioridad_alerta {
  ALTA
  MEDIA
}

Enum estado_alerta {
  PENDIENTE
  EN_ATENCION
  ATENDIDA
}

Enum resultado_inspeccion {
  SIN_HALLAZGO
  OBSERVACION
  ACTA
}

Table rol {
  id_rol smallint [pk, increment]
  codigo varchar(20) [not null, unique, note: 'Código corto del rol.']
  nombre varchar(60) [not null, note: 'Nombre del rol.']
  Note: 'Roles del sistema (siete roles de negocio, RF01).'
}

Table lugar_desembarque {
  id_lugar integer [pk, increment]
  codigo varchar(10) [not null, unique, note: 'Código del DPA o caleta.']
  nombre varchar(80) [not null, note: 'Nombre del lugar.']
  tipo sirdepa.tipo_lugar [not null, default: `'DPA'::sirdepa.tipo_lugar`, note: 'DPA o caleta.']
  region varchar(40) [not null, note: 'Región donde está el lugar.']
  Note: 'DPA y caletas donde se registra el desembarque.'
}

Table usuario {
  id_usuario uuid [pk, default: `gen_random_uuid()`]
  dni char(8) [not null, unique, note: 'DNI con el que ingresa (8 dígitos).']
  celular varchar(9) [not null, note: 'Celular que recibe el código SMS.']
  pin_hash varchar(100) [note: 'Argon2id; NULL en roles sin PIN']
  id_rol smallint [not null]
  id_lugar integer [note: 'solo roles del DPA']
  activo boolean [not null, default: `true`, note: 'Indica si la cuenta está habilitada.']
  intentos_fallidos smallint [not null, default: `0`, note: 'Intentos fallidos seguidos; al quinto se bloquea.']
  bloqueado_hasta timestamptz [note: 'Fin del bloqueo temporal por intentos fallidos.']
  Note: 'Personas con cuenta; ingresan con DNI, PIN y código SMS (RF01, RNF08).'
}

Table armador {
  id_armador integer [pk, increment]
  tipo_doc varchar(3) [not null, note: 'DNI, RUC o CE.']
  num_doc varchar(11) [not null, note: 'Número de documento.']
  nombre varchar(120) [not null, note: 'Nombre o razón social.']
  celular varchar(9) [not null, note: 'Celular para avisos y constancias.']
  id_usuario uuid [unique]
  indexes {
    (tipo_doc, num_doc) [unique]
  }
  Note: 'Propietario o responsable de la embarcación; puede existir antes de tener cuenta.'
}

Table comprador {
  id_comprador integer [pk, increment]
  tipo_doc varchar(3) [not null, note: 'DNI, RUC o CE.']
  num_doc varchar(11) [not null, note: 'Número de documento.']
  nombre varchar(120) [not null, note: 'Nombre o razón social.']
  tipo sirdepa.tipo_comprador [not null, note: 'Comerciante, planta procesadora u otro.']
  celular varchar(9) [not null, note: 'Celular para confirmar la recepción del lote.']
  id_usuario uuid [unique]
  indexes {
    (tipo_doc, num_doc) [unique]
  }
  Note: 'Persona natural o jurídica que recibe lotes de la captura (RF14, RF15).'
}

Table embarcacion {
  id_embarcacion integer [pk, increment]
  matricula varchar(15) [not null, unique, note: 'Matrícula de la embarcación.']
  nombre varchar(80) [not null, note: 'Nombre de la embarcación.']
  eslora_m numeric(4,2) [not null, note: 'Eslora en metros.']
  bodega_m3 numeric(5,2) [not null, note: 'Capacidad de bodega en m³ (máximo 32,6 para pesca artesanal).']
  categoria sirdepa.categoria_embarcacion [not null, note: 'Artesanal o de menor escala.']
  id_armador integer [not null]
  activo boolean [not null, default: `true`, note: 'Indica si la embarcación está operativa.']
  actualizado_en timestamptz [not null, default: `now()`]
  Note: 'Embarcación artesanal o de menor escala, con su capacidad de bodega (RD01).'
}

Table especie {
  id_especie integer [pk, increment]
  codigo_fao char(3) [not null, unique, note: 'lista ASFIS (RNF11)']
  nombre_comun varchar(60) [not null, note: 'Nombre común.']
  nombre_cientifico varchar(80) [not null, note: 'Nombre científico.']
  actualizado_en timestamptz [not null, default: `now()`]
  Note: 'Especies hidrobiológicas con código ASFIS de la FAO.'
}

Table arte_pesca {
  id_arte smallint [pk, increment]
  nombre varchar(60) [not null, unique, note: 'Nombre del arte o aparejo.']
  tipo varchar(30) [not null, note: 'Clase de arte (red, anzuelo, trampa, etc.).']
  mecanizado boolean [not null, default: `false`, note: 'Indica si el arte es mecanizado.']
  actualizado_en timestamptz [not null, default: `now()`]
  Note: 'Artes y aparejos de pesca.'
}

Table zona_pesca {
  id_zona integer [pk, increment]
  codigo_cuadricula varchar(10) [not null, unique, note: 'Código de la cuadrícula.']
  dentro_5_millas boolean [not null, note: 'La cuadrícula está dentro de las 5 millas.']
  dentro_3_millas boolean [not null, note: 'La cuadrícula está dentro de las 3 millas.']
  geom geometry [note: 'celda, no posición exacta']
  actualizado_en timestamptz [not null, default: `now()`]
  Note: 'Cuadrículas de pesca con geometría PostGIS; no se guardan coordenadas exactas (RNF09).'
}

Table talla_minima {
  id_talla integer [pk, increment]
  id_especie integer [not null]
  talla_min_cm numeric(5,1) [not null, note: 'Talla mínima de captura en cm.']
  tolerancia_pct numeric(5,2) [not null, note: 'Porcentaje tolerado de ejemplares bajo talla.']
  norma varchar(60) [not null, note: 'Norma que fija la talla.']
  vigente_desde date [not null, note: 'Inicio de vigencia.']
  vigente_hasta date [note: 'NULL = vigente']
  actualizado_en timestamptz [not null, default: `now()`]
  Note: 'Talla mínima y tolerancia por especie, con vigencia sin solapes (RD03).'
}

Table limite_captura {
  id_limite integer [pk, increment]
  id_especie integer [not null]
  periodo_inicio date [not null, note: 'Inicio del periodo del límite.']
  periodo_fin date [not null, note: 'Fin del periodo del límite.']
  limite_kg numeric(14,2) [not null, note: 'Límite de captura en kg.']
  norma varchar(60) [not null, note: 'Norma que fija el límite.']
  actualizado_en timestamptz [not null, default: `now()`]
  Note: 'Límite anual de captura por especie para el avance de cuotas (RF25).'
}

Table veda {
  id_veda integer [pk, increment]
  id_especie integer [not null]
  id_zona integer [note: 'NULL = todo el litoral']
  fecha_inicio date [not null, note: 'Inicio de la veda.']
  fecha_fin date [not null, note: 'Fin de la veda.']
  norma varchar(60) [not null, note: 'Norma que dispone la veda.']
  actualizado_en timestamptz [not null, default: `now()`]
  Note: 'Periodos de veda por especie y zona (RD04).'
}

Table permiso_pesca {
  id_permiso integer [pk, increment]
  id_embarcacion integer [not null]
  num_resolucion varchar(40) [not null, note: 'Número de la resolución del permiso.']
  entidad_emisora varchar(60) [not null, note: 'Entidad que otorga el permiso (PRODUCE o gobierno regional).']
  fecha_emision date [not null, note: 'Fecha de emisión.']
  fecha_vencimiento date [not null, note: 'Fecha de vencimiento (regla de permiso vigente).']
  actualizado_en timestamptz [not null, default: `now()`]
  indexes {
    (entidad_emisora, num_resolucion) [unique]
  }
  Note: 'Permiso de pesca de cada embarcación con su vencimiento (RF03).'
}

Table permiso_especie {
  id_permiso integer [not null]
  id_especie integer [not null]
  indexes {
    (id_permiso, id_especie) [pk]
  }
  Note: 'Especies autorizadas por permiso (relación N:M, 4FN).'
}

Table permiso_arte {
  id_permiso integer [not null]
  id_arte smallint [not null]
  indexes {
    (id_permiso, id_arte) [pk]
  }
  Note: 'Artes autorizados por permiso (relación N:M, 4FN).'
}

Table aviso_arribo {
  id_aviso integer [pk, increment]
  id_embarcacion integer [not null]
  id_lugar integer [not null]
  hora_estimada timestamptz [not null, note: 'Hora estimada de llegada.']
  captura_aprox varchar(200) [note: 'Captura aproximada declarada en el aviso.']
  estado sirdepa.estado_aviso [not null, default: `'PENDIENTE'::sirdepa.estado_aviso`, note: 'Pendiente, vinculado a un desembarque o vencido.']
  Note: 'Aviso de llegada enviado por el armador (RF05).'
}

Table desembarque {
  id_desembarque uuid [pk, note: 'UUID v4 generado en el celular']
  id_embarcacion integer [not null]
  id_lugar integer [not null]
  id_registrador uuid [not null]
  id_aviso integer [unique]
  id_zona integer [not null]
  id_arte smallint [not null]
  fecha_zarpe timestamptz [not null, note: 'Fecha de zarpe de la faena.']
  fecha_hora_arribo timestamptz [not null, note: 'Fecha y hora de arribo.']
  tripulantes smallint [not null, note: 'Número de tripulantes.']
  estado_validacion sirdepa.estado_validacion [note: 'NULL hasta validar en el servidor']
  validacion_preliminar sirdepa.estado_validacion [note: 'calculada sin conexión']
  estado_registro sirdepa.estado_registro [not null, default: `'VIGENTE'::sirdepa.estado_registro`, note: 'Vigente o anulado; un registro no se borra.']
  registrado_en timestamptz [not null, note: 'hora del celular']
  sincronizado_en timestamptz [not null, default: `now()`, note: 'Momento en que llegó al servidor desde el celular.']
  motivo_anulacion varchar(300) [note: 'Motivo obligatorio cuando se anula.']
  Note: 'Llegada de una faena a un lugar de desembarque. PK UUID generado en el celular (RNF07).'
}

Table detalle_desembarque {
  id_detalle bigint [pk, increment]
  id_desembarque uuid [not null]
  id_especie integer [not null]
  peso_kg numeric(10,2) [not null, note: 'Peso desembarcado en kg.']
  presentacion varchar(20) [not null, default: `'ENTERO'::character varying`, note: 'Presentación del producto; por defecto ENTERO.']
  precio_playa_kg numeric(8,2) [note: 'Precio en playa por kg (opcional).']
  destino_saldo sirdepa.destino_saldo [note: 'justificación del saldo (RF24)']
  indexes {
    (id_desembarque, id_especie) [unique]
  }
  Note: 'Kilos por especie de cada desembarque (RF07).'
}

Table muestreo_talla {
  id_muestreo bigint [pk, increment]
  id_detalle bigint [not null, unique]
  tallas_cm "numeric(5,1)[]" [not null, note: 'Tallas medidas en cm (arreglo).']
  pct_bajo_talla numeric(5,2) [not null, note: 'Porcentaje de ejemplares bajo la talla mínima, calculado.']
  Note: 'Muestreo de tallas de un detalle (RF09).'
}

Table resultado_validacion {
  id_resultado bigint [pk, increment]
  id_desembarque uuid [not null]
  regla varchar(30) [not null, note: 'Regla evaluada, una de las cinco del motor.']
  nivel sirdepa.estado_validacion [not null, note: 'Conforme, Observado o No conforme.']
  mensaje varchar(200) [not null, note: 'Explicación del resultado.']
  norma varchar(60) [note: 'Norma aplicada.']
  evaluado_en timestamptz [not null, default: `now()`, note: 'Fecha y hora de la evaluación.']
  Note: 'Resultado de cada una de las cinco reglas del motor de validación (RF10).'
}

Table constancia {
  id_constancia integer [pk, increment]
  id_desembarque uuid [not null, unique]
  codigo varchar(12) [not null, unique, note: 'SIR-000123']
  hash_sha256 char(64) [not null, note: 'Hash SHA-256 del contenido, para verificarla.']
  url_qr varchar(200) [not null, note: 'Enlace del QR de verificación.']
  estado sirdepa.estado_constancia [not null, default: `'VIGENTE'::sirdepa.estado_constancia`, note: 'Vigente o anulada.']
  fecha_emision timestamptz [not null, default: `now()`, note: 'Fecha y hora de emisión.']
  Note: 'Constancia de desembarque con código, QR y hash SHA-256 (RF13).'
}

Table evidencia_foto {
  id_foto bigint [pk, increment]
  id_desembarque uuid [not null]
  url varchar(200) [not null, note: 'Ubicación del archivo en el almacenamiento.']
  hash_sha256 char(64) [not null, note: 'Hash del archivo, para detectar cambios.']
  tamano_kb integer [not null, note: 'Tamaño en KB después de comprimir.']
  Note: 'Fotografías del desembarque, máximo tres (RF11).'
}

Table lote_destino {
  id_lote bigint [pk, increment]
  id_detalle bigint [not null]
  id_comprador integer [not null]
  codigo_lote varchar(16) [not null, unique, note: 'SIR-000123-L02']
  hash_qr char(64) [not null, note: 'Hash del QR del lote.']
  peso_kg numeric(10,2) [not null, note: 'Kilos asignados al comprador.']
  placa_vehiculo varchar(8) [note: 'Placa del vehículo que traslada el lote.']
  dni_conductor char(8) [note: 'DNI del conductor.']
  estado sirdepa.estado_lote [not null, default: `'ASIGNADO'::sirdepa.estado_lote`, note: 'Asignado, recibido o anulado.']
  recibido_en timestamptz [note: 'Fecha y hora de la recepción confirmada.']
  Note: 'Lote de captura asignado a un comprador, con su QR (RF14).'
}

Table notificacion {
  id_notificacion bigint [pk, increment]
  id_lote bigint
  id_constancia integer
  id_permiso integer
  tipo sirdepa.tipo_notificacion [not null, note: 'Motivo del SMS: código de acceso, constancia, lote o aviso de permiso.']
  celular varchar(9) [not null, note: 'Número de destino.']
  estado sirdepa.estado_envio [not null, default: `'PENDIENTE'::sirdepa.estado_envio`, note: 'Pendiente, enviado o fallido.']
  intentos smallint [not null, default: `0`, note: 'Número de intentos de envío.']
  creada_en timestamptz [not null, default: `now()`, note: 'Fecha y hora de creación.']
  enviada_en timestamptz [note: 'Fecha y hora de envío.']
  Note: 'Bandeja de salida de SMS con reintentos (RF13, RF22).'
}

Table alerta {
  id_alerta integer [pk, increment]
  id_desembarque uuid [not null]
  tipo sirdepa.tipo_alerta [not null, note: 'Resultado que la generó: No conforme u Observado.']
  prioridad sirdepa.prioridad_alerta [not null, note: 'Alta o media.']
  estado sirdepa.estado_alerta [not null, default: `'PENDIENTE'::sirdepa.estado_alerta`, note: 'Pendiente, en atención o atendida.']
  creada_en timestamptz [not null, default: `now()`, note: 'Fecha y hora de creación.']
  atendida_en timestamptz [note: 'Fecha y hora en que se atendió.']
  Note: 'Alertas para el fiscalizador por resultados Observado o No conforme (RF22).'
}

Table inspeccion {
  id_inspeccion integer [pk, increment]
  id_desembarque uuid [not null]
  id_alerta integer
  id_fiscalizador uuid [not null]
  resultado sirdepa.resultado_inspeccion [not null, note: 'Sin hallazgo, observación o acta.']
  numero_acta varchar(30) [unique, note: 'Número del acta, si se levantó.']
  observacion varchar(500) [note: 'Detalle de lo observado.']
  registrada_en timestamptz [not null, default: `now()`, note: 'Fecha y hora del registro.']
  Note: 'Actuaciones del fiscalizador: observaciones y actas (RF17).'
}

Table cierre_diario {
  id_cierre integer [pk, increment]
  id_lugar integer [not null]
  cerrado_por uuid [not null]
  fecha date [not null, note: 'Día que se cierra.']
  kg_registrados numeric(14,2) [not null, note: 'Kilos desembarcados en el día.']
  kg_asignados numeric(14,2) [not null, note: 'Kilos asignados a compradores.']
  kg_saldo_justificado numeric(14,2) [not null, note: 'Diferencia justificada (merma, consumo, etc.).']
  cerrado_en timestamptz [not null, default: `now()`, note: 'Fecha y hora del cierre.']
  indexes {
    (id_lugar, fecha) [unique]
  }
  Note: 'Cierre del día por lugar con cuadre de kilos (RF24).'
}

Table auditoria {
  id_auditoria bigint [pk, increment]
  id_usuario uuid
  tabla varchar(40) [not null, note: 'Tabla afectada.']
  operacion char(1) [not null, note: 'I (inserción), U (actualización) o D (eliminación).']
  id_registro varchar(40) [not null, note: 'Identificador del registro afectado.']
  datos_antes_despues jsonb [not null, note: 'Valores antes y después del cambio (JSONB).']
  fecha timestamptz [not null, default: `now()`, note: 'Fecha y hora del cambio.']
  Note: 'Bitácora inmutable (RF23, RNF10). Solo se inserta mediante triggers.'
}

Table codigo_otp {
  id_otp bigint [pk, increment]
  id_usuario uuid [not null]
  codigo_hash char(64) [not null, note: 'SHA-256 del código de 6 dígitos']
  expira_en timestamptz [not null, note: 'emisión + 5 minutos (RNF08)']
  usado_en timestamptz [note: 'Momento en que se usó; un código no se reutiliza.']
  intentos smallint [not null, default: `0`, note: 'Intentos de ingreso del código.']
  Note: 'Códigos SMS de un solo uso, guardados como hash (8.4).'
}

Table sesion {
  id_sesion uuid [pk, default: `gen_random_uuid()`]
  id_usuario uuid [not null]
  id_dispositivo varchar(64) [note: 'celular del registrador']
  refresh_hash char(64) [not null, unique, note: 'token de renovación (hash)']
  creada_en timestamptz [not null, default: `now()`, note: 'Inicio de la sesión.']
  expira_en timestamptz [not null, note: 'Vencimiento del token de renovación.']
  revocada_en timestamptz [note: 'Momento en que se cerró o revocó.']
  Note: 'Sesiones con el hash del token de renovación (8.4).'
}

Ref fk_alerta_desembarque: alerta.id_desembarque > desembarque.id_desembarque
Ref fk_armador_usuario: armador.id_usuario > usuario.id_usuario
Ref fk_auditoria_usuario: auditoria.id_usuario > usuario.id_usuario
Ref fk_aviso_embarcacion: aviso_arribo.id_embarcacion > embarcacion.id_embarcacion
Ref fk_aviso_lugar: aviso_arribo.id_lugar > lugar_desembarque.id_lugar
Ref fk_cierre_lugar: cierre_diario.id_lugar > lugar_desembarque.id_lugar
Ref fk_cierre_usuario: cierre_diario.cerrado_por > usuario.id_usuario
Ref fk_otp_usuario: codigo_otp.id_usuario > usuario.id_usuario [delete: cascade]
Ref fk_comprador_usuario: comprador.id_usuario > usuario.id_usuario
Ref fk_constancia_desembarque: constancia.id_desembarque > desembarque.id_desembarque
Ref fk_desembarque_arte: desembarque.id_arte > arte_pesca.id_arte
Ref fk_desembarque_aviso: desembarque.id_aviso > aviso_arribo.id_aviso
Ref fk_desembarque_embarcacion: desembarque.id_embarcacion > embarcacion.id_embarcacion
Ref fk_desembarque_lugar: desembarque.id_lugar > lugar_desembarque.id_lugar
Ref fk_desembarque_registrador: desembarque.id_registrador > usuario.id_usuario
Ref fk_desembarque_zona: desembarque.id_zona > zona_pesca.id_zona
Ref fk_detalle_desembarque: detalle_desembarque.id_desembarque > desembarque.id_desembarque [delete: cascade]
Ref fk_detalle_especie: detalle_desembarque.id_especie > especie.id_especie
Ref fk_embarcacion_armador: embarcacion.id_armador > armador.id_armador
Ref fk_foto_desembarque: evidencia_foto.id_desembarque > desembarque.id_desembarque [delete: cascade]
Ref fk_inspeccion_alerta: inspeccion.id_alerta > alerta.id_alerta
Ref fk_inspeccion_desembarque: inspeccion.id_desembarque > desembarque.id_desembarque
Ref fk_inspeccion_fiscalizador: inspeccion.id_fiscalizador > usuario.id_usuario
Ref fk_limite_especie: limite_captura.id_especie > especie.id_especie
Ref fk_lote_comprador: lote_destino.id_comprador > comprador.id_comprador
Ref fk_lote_detalle: lote_destino.id_detalle > detalle_desembarque.id_detalle
Ref fk_muestreo_detalle: muestreo_talla.id_detalle > detalle_desembarque.id_detalle [delete: cascade]
Ref fk_notificacion_constancia: notificacion.id_constancia > constancia.id_constancia
Ref fk_notificacion_lote: notificacion.id_lote > lote_destino.id_lote
Ref fk_notificacion_permiso: notificacion.id_permiso > permiso_pesca.id_permiso
Ref fk_pa_arte: permiso_arte.id_arte > arte_pesca.id_arte
Ref fk_pa_permiso: permiso_arte.id_permiso > permiso_pesca.id_permiso [delete: cascade]
Ref fk_pe_especie: permiso_especie.id_especie > especie.id_especie
Ref fk_pe_permiso: permiso_especie.id_permiso > permiso_pesca.id_permiso [delete: cascade]
Ref fk_permiso_embarcacion: permiso_pesca.id_embarcacion > embarcacion.id_embarcacion [delete: cascade]
Ref fk_resultado_desembarque: resultado_validacion.id_desembarque > desembarque.id_desembarque [delete: cascade]
Ref fk_sesion_usuario: sesion.id_usuario > usuario.id_usuario [delete: cascade]
Ref fk_talla_especie: talla_minima.id_especie > especie.id_especie
Ref fk_usuario_lugar: usuario.id_lugar > lugar_desembarque.id_lugar
Ref fk_usuario_rol: usuario.id_rol > rol.id_rol
Ref fk_veda_especie: veda.id_especie > especie.id_especie
Ref fk_veda_zona: veda.id_zona > zona_pesca.id_zona
